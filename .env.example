# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# ---------------------------------------------------------------- networking
# The server binds loopback by default. Only change this if a proxy or tunnel
# terminates TLS in front of it AND authentication is enabled; the server
# refuses to start on a non-loopback address without auth.
# MCP_ORCHESTRATOR_HOST=127.0.0.1
# MCP_ORCHESTRATOR_PORT=8787

# ---------------------------------------------------------- authentication
# "none" is only permitted on loopback. Use "bearer" for any remote exposure.
# MCP_ORCHESTRATOR_AUTH_MODE=bearer
#
# Generate with:  openssl rand -base64 48
# Must be at least 24 characters; the server rejects shorter tokens.
# MCP_ORCHESTRATOR_TOKEN=replace-me-with-a-long-random-value

# ------------------------------------------------------------------- config
# Explicit config file path. Otherwise config/orchestrator.yaml is used.
# MCP_ORCHESTRATOR_CONFIG=/absolute/path/to/orchestrator.yaml

# MCP_ORCHESTRATOR_LOG_LEVEL=info
# MCP_ORCHESTRATOR_DB_PATH=data/orchestrator.sqlite

# -------------------------------------------------------------------- Mem0
# Prefer pointing `memory.envFile` in orchestrator.yaml at an existing Mem0 env
# file rather than duplicating these here.
# MEM0_BASE_URL=https://mem0.example.internal
# MEM0_API_KEY=
# MEM0_USER_ID=
